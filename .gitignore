# This is a monorepo — backend/ and frontend/ each have their own more
# specific .gitignore (Maven build output, node_modules, .env, etc.).
# This root-level file only covers things that could appear outside either
# package (OS/editor junk, and this repo's root-level .env if one is ever
# added for docker-compose overrides).
.DS_Store
Thumbs.db
# Leading slash = root-level only, so this doesn't shadow frontend/.vscode
# (frontend/.gitignore deliberately keeps some files there tracked).
/.idea/
/.vscode/
.env
.env.*.local

# Copy this file to .env for local development:
#   cp .env.example .env
# Then fill in the real values below.
#
# `npm start` / `npm run build` read this file (via scripts/generate-env.js)
# and generate src/environments/environment.ts / environment.prod.ts from it
# before Angular CLI runs — Angular itself cannot read .env files directly.
#
# On Render (production), do NOT commit real values here. Instead, set these
# same variable names as real Environment Variables in the Render service's
# dashboard (Settings > Environment). The build command (`npm run build`)
# will pick them up from the environment automatically — no .env file is
# needed or present on Render.

# Base URL of the backend API, including the /api prefix.
# Local: the backend running on your machine.
# Render: your deployed backend service's public URL + /api
#         (e.g. https://authapp-backend.onrender.com/api) — set in Step 4.
API_BASE_URL=http://localhost:8080/api

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Must be the SAME Client ID as GOOGLE_CLIENT_ID in
# backend/.env. Add this app's origin (http://localhost:4200 for local,
# and your deployed Render frontend URL later) to that Client ID's
# "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Copy this file to .env for local development.
# On Render, set these as environment variables in the service dashboard instead.

SERVER_PORT=8080

# Local Postgres (see ../docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/authapp
DB_USER=authapp
DB_PASS=authapp

# Must be at least 32 characters long
JWT_SECRET=change-this-secret-in-env-minimum-32-characters-long
JWT_EXPIRATION_MINUTES=120

# Angular dev server origin
FRONTEND_URL=http://localhost:4200

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Must be the SAME Client ID as GOOGLE_CLIENT_ID in frontend/.env (see
# frontend/.env.example — frontend and backend must agree on which Google
# app this is, or token verification will fail).
# Authorized JavaScript origins to register on that Client ID: http://localhost:4200
# (and your deployed frontend URL, once on Render). No redirect URI needed for this flow.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Set to true only when serving over HTTPS (e.g. on Render), so the
# cookie can be marked Secure + SameSite=None for cross-site requests.
COOKIE_SECURE=false

# --- Step 3: Passkey / WebAuthn ---
# RP ID must be the frontend's bare domain (no scheme/port). "localhost" works
# for local dev only. When deploying to Render (Step 4), change this to the
# real frontend domain — a passkey registered under one RP ID will NOT work
# for logging in under a different one, so this can't be changed after users
# have already registered passkeys against it.
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Auth App
# Must exactly match the frontend origin (scheme + host + port) the browser sends.
PASSKEY_ORIGIN=http://localhost:4200

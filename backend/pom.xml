<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>authapp</artifactId>
    <version>0.4.0</version>
    <name>authapp</name>
    <description>Auth system backend - Step 4 (email/password + Google OAuth2 + Passkey/WebAuthn, Render-ready)</description>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <!--
      Works around an upstream Maven Central publishing bug: com.yubico:webauthn-server-core:2.9.0
      transitively pulls in com.fasterxml.jackson.dataformat:jackson-dataformat-cbor:2.18.5, and that
      specific released artifact's own POM (as published) points to jackson-databind:2.18.9-SNAPSHOT,
      which was never published to Maven Central and only briefly existed in FasterXML's internal
      snapshot repo. This is a known, recurring class of bug in FasterXML's release tooling (has
      happened across several past Jackson releases) — not something wrong in this app's own code.
      Fix: explicitly manage jackson-dataformat-cbor's version ourselves, pinned to
      ${jackson-bom.version} — the same Jackson release Spring Boot's parent POM already manages for
      jackson-databind/jackson-core/jackson-annotations elsewhere in this app. Because a dependency
      version declared directly in THIS project's own <dependencyManagement> always wins over any
      version pulled in transitively (e.g. from webauthn-server-core's own imported BOM), this
      guarantees Maven never touches the broken 2.18.5 POM, and keeps every Jackson module in the
      whole app on one single, consistent, real release.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-cbor</artifactId>
                <version>${jackson-bom.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Step 4: exposes /actuator/health (public, see SecurityConfig), used as
             Render's Health Check Path so Render can tell the deploy is actually up. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Postgres -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- dotenv support for local .env loading -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
            <version>4.0.0</version>
        </dependency>

        <!-- Google ID token verification (Google Identity Services login/registration flow).
             ID-token verification only needs the OAuth2 Client ID, no client secret. -->
        <dependency>
            <groupId>com.google.api-client</groupId>
            <artifactId>google-api-client</artifactId>
            <version>2.7.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.http-client</groupId>
            <artifactId>google-http-client-gson</artifactId>
            <version>1.45.0</version>
        </dependency>

        <!-- Step 3: Passkey / WebAuthn. Yubico's library implements the full
             W3C WebAuthn Relying Party spec (challenge generation, attestation/
             assertion validation, signature-counter replay checks) so we don't
             hand-roll any of the cryptographic verification ourselves. -->
        <dependency>
            <groupId>com.yubico</groupId>
            <artifactId>webauthn-server-core</artifactId>
            <version>2.9.0</version>
        </dependency>

        <!-- In-memory TTL cache for pending WebAuthn registration/login challenges.
             The API is stateless (JWT-in-cookie, no HttpSession), so challenges
             created by startRegistration/startAssertion are held here briefly
             (keyed by a random requestId handed to the client) until the matching
             finishRegistration/finishAssertion call arrives or the entry expires. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>3.1.8</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
